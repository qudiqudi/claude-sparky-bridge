# Required
CLAUDE_CODE_OAUTH_TOKEN=
BRIDGE_TOKEN=
# The Docker network of your SparkyFitness server container:
# docker ps --filter name=sparkyfitness-server --format '{{.Names}}: {{.Networks}}'
SPARKY_NETWORK=sparkyfitness_sparkyfitness-network

# Optional
# TZ=UTC
# BRIDGE_MODEL=sonnet
# BRIDGE_CLASSIFIER_MODEL=haiku
# BRIDGE_EFFORT=low
# BRIDGE_DAILY_LIMIT=300
# BRIDGE_TIMEOUT_S=240

# Optional limits (bytes, counts)
# BRIDGE_MAX_BODY_BYTES=25000000
# BRIDGE_MAX_IMAGE_BYTES=12000000
# BRIDGE_MAX_TOTAL_IMAGE_BYTES=16000000
# BRIDGE_MAX_IMAGES=4
# BRIDGE_MAX_PROMPT_BYTES=900000
# BRIDGE_MAX_CONCURRENT=2
# BRIDGE_MAX_QUEUED=8

# Cache mark on the tool list; 0 turns it off
# BRIDGE_CACHE_TOOLS=1
